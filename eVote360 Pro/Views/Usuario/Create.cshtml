@model Application.Dtos.UsuarioDto

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i> Registrar Nuevo Usuario</h5>
            </div>
            <div class="card-body p-4">
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control" required placeholder="Escriba el nombre" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellido" class="form-label fw-semibold text-secondary">Apellido <span class="text-danger">*</span></label>
                            <input asp-for="Apellido" class="form-control" required placeholder="Escriba el apellido" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">Correo Electronico <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" required placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold text-secondary">Nombre de Usuario <span class="text-danger">*</span></label>
                        <input asp-for="NombreUsuario" class="form-control" required placeholder="Ej: jgomez" />
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label name="password" class="form-label fw-semibold text-secondary">Password / Contrasena <span class="text-danger">*</span></label>
                        <input name="password" type="password" class="form-control" required placeholder="Asigne una contrasena" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold text-secondary">Rol de Sistema <span class="text-danger">*</span></label>
                        <select asp-for="Rol" class="form-select" id="Rol" required>
                            <option value="">-- Seleccione Rol --</option>
                            <option value="1">Administrador</option>
                            <option value="2">Dirigente Politico</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="grupoPartido" style="display: none;">
                        <label asp-for="PartidoPoliticoId" class="form-label fw-semibold text-secondary">Asignar Partido Politico</label>
                        <select asp-for="PartidoPoliticoId" class="form-select" asp-items="@(new SelectList(ViewBag.PartidosDisponibles, "Id", "Nombre"))">
                            <option value="">-- Ninguno --</option>
                        </select>
                        <span asp-validation-for="PartidoPoliticoId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-4 border-top pt-3">
                        <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="fas fa-save me-1"></i> Guardar Usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById("Rol").addEventListener("change", function () {
            var rolSeleccionado = this.value;
            var grupoPartido = document.getElementById("grupoPartido");
            var selectPartido = document.querySelector("[name='PartidoPoliticoId']");

            if (rolSeleccionado === "1" || rolSeleccionado === "") {
                grupoPartido.style.display = "none"; 
                selectPartido.value = ""; 
            } else {
                grupoPartido.style.display = "block"; 
            }
        });

        window.addEventListener("DOMContentLoaded", function() {
            document.getElementById("Rol").dispatchEvent(new Event("change"));
        });
    </script>
}