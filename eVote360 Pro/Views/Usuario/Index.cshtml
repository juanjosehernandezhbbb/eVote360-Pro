@model IEnumerable<Application.Dtos.UsuarioDto>

@{
    ViewData["Title"] = "Catalogo de Usuarios";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Usuarios Registrados</h5>
        <a asp-action="Create" class="btn btn-light btn-sm text-primary fw-bold">
            <i class="fas fa-plus"></i> Nuevo Usuario
        </a>
    </div>
    <div class="card-body">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Nombre Usuario</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th style="width: 100px;">Estado</th>
                        <th style="width: 120px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-users-slash fa-2x d-block mb-2"></i> No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre @item.Apellido</td>
                            <td class="fw-bold text-primary">@item.NombreUsuario</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Rol == 1)
                                {
                                    <span class="text-dark"><i class="fas fa-user-shield text-danger"></i> Administrador</span>
                                }
                                else
                                {
                                    <span class="text-dark"><i class="fas fa-user-tie text-primary"></i> Dirigente Politico</span>
                                }
                            </td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="nuevoEstado" value="@((!item.Estado).ToString().ToLower())" />
                                    <button type="submit" class="btn btn-sm @(item.Estado ? "btn-danger" : "btn-success")" title="@(item.Estado ? "Desactivar" : "Activar")">
                                        <i class="fas @(item.Estado ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>