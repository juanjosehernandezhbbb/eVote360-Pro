@model Application.Dtos.PuestoElectivoDto

@{
    ViewData["Title"] = "Editar Puesto Electivo";
}

<div class="card shadow-sm max-w-lg mx-auto">
    <div class="card-header bg-warning text-dark fw-bold">
        <h5 class="mb-0"><i class="fas fa-edit"></i> Modificar Puesto Electivo</h5>
    </div>
    <div class="card-body">
        
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

        <form asp-action="Edit" method="post">
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label font-weight-bold">Nombre del Puesto <span class="text-danger">*</span></label>
                <input asp-for="Nombre" class="form-control" required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción de las Funciones <span class="text-danger">*</span></label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label d-block">Estado Operativo</label>
                <div class="form-check form-switch">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" role="switch" id="switchEstado">
                    <label class="form-check-label text-muted" for="switchEstado">Permitir asignación de candidatos a este puesto</label>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-warning text-dark fw-bold">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}