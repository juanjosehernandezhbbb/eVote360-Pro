@model Application.ViewModels.CandidatoViewModel

@{
    ViewData["Title"] = "Editar Candidato";
}

<div class="card shadow-sm max-w-lg mx-auto">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Editar Candidato</h5>
    </div>
    <div class="card-body">
        
        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

        <form asp-controller="Candidato" asp-action="Edit" method="post" enctype="multipart/form-data">
            
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FotoUrl" /> 

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input asp-for="Nombre" class="form-control" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido <span class="text-danger">*</span></label>
                    <input asp-for="Apellido" class="form-control" required />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="PartidoPoliticoId" class="form-label">Partido Politico <span class="text-danger">*</span></label>
                <select asp-for="PartidoPoliticoId" class="form-select" required
                        asp-items="@(new SelectList(ViewBag.Partidos, "Id", "Nombre"))">
                    <option value="">-- Seleccione un partido --</option>
                </select>
                <span asp-validation-for="PartidoPoliticoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Foto Actual</label>
                <div>
                    <img src="@Model.FotoUrl" alt="Foto Candidato" style="max-width: 150px;" class="img-thumbnail" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="FotoFile" class="form-label">Cambiar Fotografia</label>
                <input asp-for="FotoFile" class="form-control" type="file" />
                <span asp-validation-for="FotoFile" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-controller="Candidato" asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}