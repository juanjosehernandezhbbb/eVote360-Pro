@model Application.Dtos.PartidoPoliticoDto

@{
    ViewData["Title"] = "Registrar Partido Político";
}

<div class="card shadow-sm max-w-xl mx-auto">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Nuevo Partido Político</h5>
    </div>
    <div class="card-body">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre del Partido <span class="text-danger">*</span></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Partido de la Liberación Dominicana" required />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Siglas" class="form-label">Siglas <span class="text-danger">*</span></label>
                    <input asp-for="Siglas" class="form-control" placeholder="Ej. PLD" required />
                    <span asp-validation-for="Siglas" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="LogoUrl" class="form-label">URL del Logo / Emblema</label>
                <input asp-for="LogoUrl" type="url" class="form-control" placeholder="https://dominio.com/imagenes/logo.png" />
                <span asp-validation-for="LogoUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción o Reseña Histórica</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Opcional..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Guardar Partido
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}