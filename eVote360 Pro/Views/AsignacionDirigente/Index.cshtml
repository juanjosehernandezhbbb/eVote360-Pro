@model IEnumerable<Application.Dtos.AsignacionDirigenteDto>

@{
    ViewData["Title"] = "Dirigentes Asignados";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Dirigentes y Partidos Asignados</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva Asignación</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Dirigente</th>
                    <th>Usuario</th>
                    <th>Partido Político</th>
                    <th>Siglas</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.NombreDirigente</td>
                            <td class="align-middle">@item.NombreUsuario</td>
                            <td class="align-middle">@item.NombrePartido</td>
                            <td class="align-middle">@item.SiglasPartido</td>
                            <td class="align-middle text-center">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Estás seguro de eliminar esta asignación?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">No hay dirigentes asignados a partidos actualmente.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>