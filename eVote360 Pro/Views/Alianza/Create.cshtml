@model Application.ViewModels.CrearSolicitudViewModel

@{
    ViewData["Title"] = "Solicitar Alianza";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Invitar a un Partido Politico</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Seleccione el partido con el que desea formar una alianza estrategica para las proximas elecciones.</p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="PartidoReceptorId" class="form-label fw-bold"></label>
                        <select asp-for="PartidoReceptorId" class="form-select" asp-items="@(new SelectList(ViewBag.PartidosDisponibles, "Id", "Nombre"))">
                            <option value="">-- Seleccione un partido --</option>
                        </select>
                        <span asp-validation-for="PartidoReceptorId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}