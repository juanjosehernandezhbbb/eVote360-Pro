@model Application.ViewModels.AlianzasDashboardViewModel

@{
    ViewData["Title"] = "Centro de Alianzas Politicas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestion de Alianzas</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-handshake"></i> Nueva Solicitud
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning text-dark fw-bold">
                Solicitudes Recibidas (Pendientes)
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.SolicitudesPendientes.Any())
                    {
                        foreach (var item in Model.SolicitudesPendientes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.NombrePartidoSolicitante</strong> (@item.SiglasPartidoSolicitante)<br />
                                    <small class="text-muted">Enviado: @item.FechaSolicitud.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="d-flex gap-2">
                                    <form asp-action="Aceptar" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">Aceptar</button>
                                    </form>
                                    <form asp-action="Rechazar" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">Rechazar</button>
                                    </form>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">No tienes solicitudes pendientes.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white fw-bold">
                Solicitudes Enviadas
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.SolicitudesRealizadas.Any())
                    {
                        foreach (var item in Model.SolicitudesRealizadas)
                        {
                            <li class="list-group-item">
                                <strong>Para:</strong> @item.NombrePartidoReceptor (@item.SiglasPartidoReceptor)<br />
                                <small class="text-muted">Fecha: @item.FechaSolicitud.ToString("dd/MM/yyyy")</small>
                                <span class="badge bg-info float-end mt-1">Pendiente</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">No has enviado ninguna solicitud.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-success">
    <div class="card-header bg-success text-white fw-bold">
        Alianzas Vigentes
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Partido Aliado</th>
                        <th>Siglas</th>
                        <th>Fecha de Aprobacion</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AlianzasVigentes.Any())
                    {
                        foreach (var item in Model.AlianzasVigentes)
                        {
                            // Determinar cual es el aliado (si soy el solicitante, el aliado es el receptor, y viceversa)
                            bool soySolicitante = item.PartidoSolicitanteId == Model.MiPartidoId;
                            string aliadoNombre = soySolicitante ? item.NombrePartidoReceptor : item.NombrePartidoSolicitante;
                            string aliadoSiglas = soySolicitante ? item.SiglasPartidoReceptor : item.SiglasPartidoSolicitante;

                            <tr>
                                <td><strong>@aliadoNombre</strong></td>
                                <td>@aliadoSiglas</td>
                                <td>@(item.FechaRespuesta?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end">
                                    <form asp-action="EliminarVigente" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Terminar Alianza</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No tienes alianzas vigentes actualmente.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>