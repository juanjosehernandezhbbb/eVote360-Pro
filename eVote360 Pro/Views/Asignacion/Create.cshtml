@model eVote360_Pro.Models.CrearAsignacionViewModel
@{
    ViewData["Title"] = "Asignar Candidato";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Asignar Candidato a Puesto Electivo</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CandidatoId" class="form-label fw-bold">Seleccionar Candidato</label>
                        <select asp-for="CandidatoId" asp-items="Model.Candidatos" class="form-select">
                            <option value="">-- Elija un candidato --</option>
                        </select>
                        <span asp-validation-for="CandidatoId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PuestoElectivoId" class="form-label fw-bold">Seleccionar Puesto</label>
                        <select asp-for="PuestoElectivoId" asp-items="Model.Puestos" class="form-select">
                            <option value="">-- Elija un puesto --</option>
                        </select>
                        <span asp-validation-for="PuestoElectivoId" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success">Guardar Asignación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}