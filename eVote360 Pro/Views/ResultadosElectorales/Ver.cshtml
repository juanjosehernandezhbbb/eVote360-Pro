@model List<Application.Dtos.ResultadoPuestoDto>

@foreach (var puesto in Model)
{
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white">
            <h5>@puesto.NombrePuesto</h5>
        </div>
        <div class="card-body">
            <canvas id="chart_@puesto.NombrePuesto.Replace(" ", "_")"></canvas>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tu código de Chart.js va aquí...
            // Esto se cargará automáticamente después de que el Layout cargue Chart.js
            
            @foreach (var puesto in Model)
            {
                <text>
                new Chart(document.getElementById('chart_@puesto.NombrePuesto.Replace(" ", "_")'), {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(puesto.ResultadosCandidatos.Select(c => c.CandidatoOpcion))),
                        datasets: [{
                            label: 'Votos',
                            data: @Html.Raw(Json.Serialize(puesto.ResultadosCandidatos.Select(c => c.CantidadVotos))),
                            backgroundColor: '#4e73df'
                        }]
                    }
                });
                </text>
            }
        });
    </script>
}