@model IEnumerable<Persistance.Dtos.EleccionDto>

@{
    ViewData["Title"] = "Resultados Electorales";
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i> Modulo de Resultados Electorales</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Proceso Electoral</th>
                        <th>Fecha</th>
                        <th class="text-center">Estado del Proceso</th>
                        <th class="text-center" style="width: 180px;">Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-poll fa-3x d-block mb-2"></i> No existen procesos electorales registrados en el sistema.
                            </td>
                        </tr>
                    }
                    @foreach (var eleccion in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark ps-4">@eleccion.Nombre</td>
                            <td>@eleccion.Fecha.ToString("dd / MM / yyyy")</td>
                            <td class="text-center">
                                @if (eleccion.EstadoEleccion == 2)
                                {
                                    <span class="badge bg-success p-2"><i class="fas fa-spinner fa-spin me-1"></i> Transcurriendo (En Vivo)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary p-2"><i class="fas fa-lock me-1"></i> Concluida / Cerrada</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Ver" asp-route-id="@eleccion.Id" asp-route-nombreEleccion="@eleccion.Nombre" class="btn btn-primary btn-sm fw-bold">
                                    <i class="fas fa-eye me-1"></i> Visualizar Graficas
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>