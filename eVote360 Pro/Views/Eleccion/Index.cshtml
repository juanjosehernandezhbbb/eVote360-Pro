@model IEnumerable<Persistance.Dtos.EleccionDto>

@{
    ViewData["Title"] = "Control de Elecciones";
    int anioSeleccionado = ViewBag.AnioActual;
}

<div class="card shadow-sm mb-4">
    <div class="card-body bg-light d-flex flex-wrap justify-content-between align-items-center gap-3">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <label class="fw-bold text-secondary mb-0">Filtrar por Anio:</label>
            <input type="number" name="anio" value="@anioSeleccionado" class="form-control form-control-sm text-center fw-bold" style="width: 100px;" min="2000" max="2100" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        
        <a asp-action="Create" class="btn btn-success btn-sm fw-bold shadow-sm">
            <i class="fas fa-plus"></i> Configurar Nueva Eleccion
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i> Procesos Electorales del Anio @anioSeleccionado</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Nombre del Proceso</th>
                        <th>Fecha de Ejecucion</th>
                        <th class="text-center">Partidos</th>
                        <th class="text-center">Puestos</th>
                        <th class="text-center">Votos Emitidos</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 220px;">Acciones Tecnicas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-folder-open fa-3x d-block mb-2"></i> No se encontraron registros de elecciones configuradas para el ano @anioSeleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark ps-3">@item.Nombre</td>
                            <td>@item.Fecha.ToString("dd / MM / yyyy")</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.CantidadPartidosParticipantes</span></td>
                            <td class="text-center"><span class="badge bg-secondary">@item.CantidadPuestosDisputados</span></td>
                            <td class="text-center fw-bold text-primary">@item.CantidadCiudadanosVotaron</td>
                            <td class="text-center">
                                @if (item.EstadoEleccion == 2)
                                {
                                    <span class="badge bg-success shadow-sm p-2"><i class="fas fa-spinner fa-spin me-1"></i> Activa / En Proceso</span>
                                }
                                else if (item.EstadoEleccion == 3)
                                {
                                    <span class="badge bg-danger p-2"><i class="fas fa-lock me-1"></i> Finalizada / Cerrada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark p-2"><i class="fas fa-clock me-1"></i> Pendiente</span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <div class="d-flex justify-content-center gap-1">
                                    @if (item.EstadoEleccion != 2 && item.EstadoEleccion != 3)
                                    {
                                        <form asp-action="Activar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="anio" value="@anioSeleccionado" />
                                            <button type="submit" class="btn btn-success btn-sm fw-bold" title="Iniciar Votaciones">
                                                <i class="fas fa-play"></i> Activar
                                            </button>
                                        </form>
                                    }

                                    @if (item.EstadoEleccion == 2)
                                    {
                                        <form asp-action="Finalizar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="anio" value="@anioSeleccionado" />
                                            <button type="submit" class="btn btn-danger btn-sm fw-bold" title="Cerrar Urnas" onclick="return confirm('¿Esta seguro de finalizar este proceso electoral? Esta accion cerrara las votaciones permanentemente.');">
                                                <i class="fas fa-stop"></i> Finalizar
                                            </button>
                                        </form>
                                    }

                                    <a asp-controller="ResultadosElectorales" asp-action="Ver" asp-route-id="@item.Id" asp-route-nombreEleccion="@item.Nombre" class="btn btn-primary btn-sm fw-bold text-white">
                                        <i class="fas fa-chart-bar"></i> Resultados
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>